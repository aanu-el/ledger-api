// Prisma schema: the single source of truth for the database.
// `pnpm migrate:new <change>` diffs this against the last migration and
// writes SQL under prisma/migrations; the generated client gives row types.
//
// Conventions:
// - Every table has a uuid `id` generated by Postgres and a `created_at`.
// - Fields are camelCase in TypeScript, mapped to snake_case in SQL via @map.
// - Money is BigInt in minor units — never Int/Float.
//
// Two constraints Prisma's schema language cannot express live in the
// migration SQL by hand (see prisma/migrations/*_init/migration.sql):
//   - CHECK (kind = 'external' OR balance >= 0) on accounts
//   - UNIQUE (currency) WHERE kind = 'external' on accounts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Compiled by plain tsc into dist/, so imports must carry .js like the rest of src.
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A customer of the API. Owns accounts; identified by an API key.
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  apiKeys  ApiKey[]
  accounts Account[]

  @@map("tenants")
}

/// A bearer credential for a tenant. Only the SHA-256 hash is stored; the key
/// itself is shown once at issue time and never persisted.
model ApiKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Unique: auth is a single indexed lookup, and two tenants can never share a key.
  keyHash   String   @unique @map("key_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("api_keys")
}

/// `user` accounts belong to a tenant and can never go negative.
/// `external` accounts are system-owned (tenantId null), one per currency, and
/// represent money outside the ledger; they are the only ones allowed below zero.
enum AccountKind {
  user
  external

  @@map("account_kind")
}

model Account {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for system accounts.
  tenantId  String?     @map("tenant_id") @db.Uuid
  kind      AccountKind
  /// ISO 4217 code, e.g. "USD". char(3) rejects any other length at the DB.
  currency  String      @db.Char(3)
  balance   BigInt      @default(0)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  /// Listing a tenant's accounts is the common query; cursor pagination
  /// orders by (created_at, id), so the index matches that order.
  @@index([tenantId, createdAt, id])
  @@map("accounts")
}
