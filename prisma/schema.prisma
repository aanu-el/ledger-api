// Database schema. `pnpm migrate:new <name>` turns changes here into SQL under
// prisma/migrations; `pnpm migrate` applies them.
//
// Two rules Prisma cannot express are hand-written in the init migration:
//   CHECK ("kind" = 'external' OR "balance" >= 0)   -- user accounts never go negative
//   UNIQUE ("currency") WHERE "kind" = 'external'    -- one external account per currency

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Compiled by plain tsc, so generated imports must end in .js like the rest of src.
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// A customer of the API. Owns accounts; authenticates with an API key.
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  apiKeys  ApiKey[]
  accounts Account[]
}

// Bearer credential for a tenant. Only the SHA-256 hash is stored.
model ApiKey {
  id        String   @id @default(uuid())
  tenantId  String
  keyHash   String   @unique
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// `user` accounts belong to a tenant. `external` accounts are system-owned
// (tenantId null), one per currency, and stand for money outside the ledger.
enum AccountKind {
  user
  external
}

model Account {
  id        String      @id @default(uuid())
  tenantId  String?
  kind      AccountKind
  currency  String // ISO 4217 code, e.g. "USD"
  balance   BigInt      @default(0) // minor units (cents, kobo)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])
}
