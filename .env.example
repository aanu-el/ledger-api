# Copy to .env for local development. `pnpm dev` and `pnpm migrate` load it automatically.
NODE_ENV=development
# 3100 rather than 3000 to stay clear of other dev servers (Next.js etc.) on this machine.
PORT=3100
LOG_LEVEL=debug

# The Compose Postgres is published on 5433 (not 5432) so it never collides
# with a Postgres already installed on the host machine.
POSTGRES_PORT=5433
DATABASE_URL=postgres://ledger:ledger@localhost:5433/ledger
