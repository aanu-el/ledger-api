{
  "name": "ledger-api",
  "version": "0.1.0",
  "description": "Double-entry ledger HTTP API: concurrency-safe transfers, idempotency keys, transactional outbox, reconciliation.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/entrypoints/api.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/entrypoints/api.js",
    "migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:new": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev --create-only --name",
    "migrate:status": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate status",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:reset": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate reset --force"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "prisma": "7.10.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testcontainers/postgresql": "^11.7.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  }
}
